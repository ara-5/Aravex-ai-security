# --- Target agent (the system under test) ---
TARGET_DATABASE_URL=sqlite:///./data/target_agent.db
TARGET_PORT=8001

# --- Red-team engine (AgentShield) ---
REDTEAM_DATABASE_URL=sqlite:///./data/redteam.db
REDTEAM_PORT=8002
TARGET_AGENT_URL=http://localhost:8001

# --- LLM backend (target_agent/llm_providers.py) ---
# Off by default: both services use a deterministic, offline "naive" LLM
# stand-in so campaigns run in seconds. Set USE_OLLAMA=true (and point
# OLLAMA_MODEL at a model you've already pulled) to red-team a real local
# model instead -- expect each attack turn to take several seconds.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_JUDGE_MODEL=llama3.2:3b
USE_OLLAMA=false

# Alternative to USE_OLLAMA: set explicitly to "naive" | "ollama" |
# "openai_compatible" to pick a provider directly (overrides USE_OLLAMA).
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Pluggable RAG embeddings (target_agent/vectorstore.py): "hash" (default,
# zero-dependency) or "ollama" (real embedding model, falls back to hash
# automatically if unreachable at startup).
EMBEDDING_PROVIDER=hash
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Secrets deliberately planted in the target agent for canary-based
#     leak detection. Do not use real secrets. ---
CANARY_API_KEY=sk-canary-7f3a9c2e1b4d
CANARY_DB_PASSWORD=Sup3rSecretDBPass!

# --- Optional shared-secret auth (empty = open, fine for local/CI) ---
# ADMIN_API_KEY=            # gates target_agent's /admin/* routes
# REDTEAM_API_KEY=          # gates redteam_engine's write endpoints
# TARGET_ADMIN_API_KEY=     # what redteam_engine sends as X-API-Key -- set to match ADMIN_API_KEY above

# --- Campaign concurrency (redteam_engine/planner.py) ---
REDTEAM_MAX_WORKERS=4

# --- Optional LLM-judge second opinion (redteam_engine/llm_judge.py) ---
# Adds a real LLM call per attempt for nuanced free-text judging,
# alongside (never instead of) the deterministic ground-truth judges.
ENABLE_LLM_JUDGE=false

# --- Optional OpenTelemetry tracing (observability.py) ---
# Exports to the console by default; set OTEL_EXPORTER_OTLP_ENDPOINT to
# send to a real collector (Jaeger, Tempo, Honeycomb, ...) instead.
ENABLE_OTEL=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
